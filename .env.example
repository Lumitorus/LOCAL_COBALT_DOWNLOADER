# Адрес, который видит браузер пользователя. Обязателен завершающий /.
API_PUBLIC_URL=http://192.168.1.50:9000/

# Имя/IP web-интерфейса без схемы и порта (используется при сборке метаданных).
WEB_HOST=192.168.1.50

# Порты на Docker-хосте.
WEB_PORT=8080
API_PORT=9000

# Зафиксированный commit официального frontend для воспроизводимой сборки.
# Чтобы собрать актуальный main, задайте COBALT_WEB_REF=main.
COBALT_WEB_REF=a636575b09de1fc55d9b8cd98cac88f5f2f16b42

# Необязательный исходящий HTTP(S)-прокси для запросов Cobalt.
COBALT_HTTP_PROXY=
COBALT_HTTPS_PROXY=
COBALT_NO_PROXY=localhost,127.0.0.1,cobalt-api,cobalt-web

# По умолчанию подключена пустая безопасная заготовка.
COOKIE_FILE=./cookies.example.json
