FROM node:24-alpine AS build

ARG COBALT_WEB_REF=main
ARG WEB_DEFAULT_API
ARG WEB_HOST=localhost
ENV WEB_DEFAULT_API=${WEB_DEFAULT_API}
ENV WEB_HOST=${WEB_HOST}
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

RUN apk add --no-cache git python3 alpine-sdk
WORKDIR /src
RUN git init \
    && git remote add origin https://github.com/imputnet/cobalt.git \
    && git fetch --depth=1 origin "${COBALT_WEB_REF}" \
    && git checkout --detach FETCH_HEAD
RUN corepack enable \
    && pnpm install --frozen-lockfile \
    && pnpm --filter @imput/cobalt-web build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build /src/web/build /usr/share/nginx/html
EXPOSE 8080
